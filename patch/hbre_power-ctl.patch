+                            settings->writeback_centisecs) != 0 ||
+           write_sysctl_int("/proc/sys/vm/dirty_background_ratio",
+                            settings->background_ratio) != 0 ||
+           write_sysctl_int("/proc/sys/vm/dirty_ratio",
+                            settings->dirty_ratio) != 0 ? -1 : 0;
